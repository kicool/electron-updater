{
  "name": "05-github-remote",
  "version": "1.0.0",
  "private": true,
  "description": "基于 GitHub 远程 git-pull 的 Electron 应用更新方案（单一源：release 给用户、master 给开发）",
  "main": "src/application/main.js",
  "scripts": {
    "start": "electron .",
    "setup": "bash scripts/setup.sh",
    "publish": "bash scripts/publish.sh",
    "verify": "bash scripts/verify.sh",
    "electron:cache": "bash scripts/electron-once.sh",
    "selftest": "node src/tools/real-remote-check.js",
    "contract-check": "node src/tools/contract-check.js",
    "core-test": "node src/tools/core-selftest.js",
    "smoke": "node src/tools/main-smoke.js",
    "matrix-test": "node src/tools/policy-matrix.js",
    "check-require": "grep -rn 'function.*{' src/ --include='*.js' -A 5 | grep 'require(' || echo '✓ 无函数内 require'"
  },
  "devDependencies": {
    "electron": "^44.4.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
